# Durable owner-scoped external TSA trust-profile registry.
EVIDENCE_GRAPH_RESTORE_CUSTODY_RFC3161_TRUST_DB_PATH=data/evidence_graph_restore_custody_rfc3161_trust.sqlite3

# Register and retire commands use the shared process-owned review actor boundary.
# Configure exactly one source; leave all blank to fail closed.
EVIDENCE_GRAPH_REVIEW_ACTOR_ID=
EVIDENCE_GRAPH_REVIEW_ACTOR_ID_PATH=
EVIDENCE_GRAPH_REVIEW_ACTOR_ASSERTION_PATH=
EVIDENCE_GRAPH_REVIEW_ACTOR_HMAC_KEY_PATH=
EVIDENCE_GRAPH_REVIEW_ACTOR_EXPECTED_ISSUER=

# TSA trust anchors, intermediate bundles, CRLs and signer fingerprints are supplied
# explicitly to the operator command and are persisted only as SHA-256 digests.
