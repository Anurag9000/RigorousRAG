# Public custody signer registry.
EVIDENCE_GRAPH_RESTORE_CUSTODY_SIGNER_DB_PATH=data/evidence_graph_set_signed_retirement_custody_signers.sqlite3

# One-operation reservations for expiring signed signer-administration credentials.
# This database must not alias the signer registry or any publication/restore journal.
EVIDENCE_GRAPH_RESTORE_CUSTODY_SIGNER_ADMIN_USE_DB_PATH=data/evidence_graph_set_signed_retirement_custody_signer_admin_uses.sqlite3

# Signed administration uses the configured signed reviewer-actor assertion source.
# Direct environment/file administration uses the separate direct-governed entrypoint.
EVIDENCE_GRAPH_REVIEW_ACTOR_ASSERTION_PATH=
EVIDENCE_GRAPH_REVIEW_ACTOR_HMAC_KEY_PATH=
EVIDENCE_GRAPH_REVIEW_ACTOR_EXPECTED_ISSUER=
