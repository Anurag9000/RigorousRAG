# Preparation-only migration cutover journal.
#
# This database stores immutable prerequisite digests, leases and ready/failed/
# cancelled audit state. The implementation has no execute or committed state.
MIGRATION_CUTOVER_DB_PATH=data/migration_cutovers.sqlite3

# The preparation command also requires the encrypted rollback configuration in
# config/migration_rollback.env.example and the shadow/promotion/preflight roots.
# No setting in this file enables live publication, restore or pointer swapping.
