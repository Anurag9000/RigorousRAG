# Public Ed25519 timestamp-authority registry for custody attestations.
# This database must not equal or hard-link to signer, custody, hold, restore,
# retirement, publication, or signer-administration databases.
EVIDENCE_GRAPH_RESTORE_CUSTODY_TIMESTAMP_AUTHORITY_DB_PATH=data/evidence_graph_set_signed_retirement_custody_timestamp_authorities.sqlite3

# One-serial durable issuance journal. This database stores signed public attestation
# payloads but never private keys or raw output paths. It must not alias the authority
# registry or any custody, restore, retirement, publication, or administration journal.
EVIDENCE_GRAPH_RESTORE_CUSTODY_TIMESTAMP_ISSUANCE_DB_PATH=data/evidence_graph_set_signed_retirement_custody_timestamp_issuances.sqlite3

# Integrity-backed legal holds over issuance records. Active holds are included by the
# retention planner when this path is explicitly supplied or exported. The hold database
# must not equal or hard-link to the issuance journal or any other protected database.
EVIDENCE_GRAPH_RESTORE_CUSTODY_TIMESTAMP_ISSUANCE_HOLD_DB_PATH=data/evidence_graph_set_signed_retirement_custody_timestamp_issuance_holds.sqlite3

# Authority registration, retirement, and hold placement/release use the existing
# process-owned actor binding. Configure exactly one direct or signed actor source.
EVIDENCE_GRAPH_REVIEW_ACTOR_ID=
EVIDENCE_GRAPH_REVIEW_ACTOR_ID_PATH=
EVIDENCE_GRAPH_REVIEW_ACTOR_ASSERTION_PATH=
EVIDENCE_GRAPH_REVIEW_ACTOR_HMAC_KEY_PATH=
EVIDENCE_GRAPH_REVIEW_ACTOR_EXPECTED_ISSUER=

# Authority private keys are supplied only to issue-governed or issuance seed.
# They are never stored in any database and must be protected by filesystem permissions.
