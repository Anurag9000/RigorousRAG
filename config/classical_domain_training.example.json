{
  "schema": "rigorousrag-authoritative-classical-training/v1",
  "kind": "domain_classifier",
  "train_data": "../data/training/classical/domain_train.jsonl",
  "validation_data": "../data/training/classical/domain_validation.jsonl",
  "output_dir": "../artifacts/training/classical/domain_classifier",
  "labels": ["general", "scientific", "multimodal", "temporal"],
  "fallback_label": "general",
  "minimum_confidence": 0.55,
  "training": {
    "learning_rate": 0.05,
    "epochs": 100,
    "batch_size": 64,
    "l2": 0.0001,
    "seed": 0,
    "patience": 10,
    "min_delta": 0.00001,
    "checkpoint_every_epochs": 1
  }
}
