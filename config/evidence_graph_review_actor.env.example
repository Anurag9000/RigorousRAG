# Configure exactly one actor identity mode.

# Mode 1: process environment identity.
EVIDENCE_GRAPH_REVIEW_ACTOR_ID=

# Mode 2: descriptor-read identity file.
EVIDENCE_GRAPH_REVIEW_ACTOR_ID_PATH=

# Mode 3: short-lived HMAC-signed assertion.
EVIDENCE_GRAPH_REVIEW_ACTOR_ASSERTION_PATH=
EVIDENCE_GRAPH_REVIEW_ACTOR_HMAC_KEY_PATH=
EVIDENCE_GRAPH_REVIEW_ACTOR_EXPECTED_ISSUER=

# Durable one-decision assertion reservation and replay audit journal.
EVIDENCE_GRAPH_REVIEW_ACTOR_USE_DB_PATH=data/evidence_graph_review_actor_uses.sqlite3

# Never configure direct-ID and signed-assertion modes together.
# Keep HMAC key files outside the repository with restricted read permissions.
