# Encrypted migration rollback artifacts
#
# Store encrypted rollback ciphertext and path-free manifests here.
MIGRATION_ROLLBACK_ROOT=data/migration_rollbacks

# Maximum decrypted canonical payload size accepted for one artifact.
# The encrypted ciphertext has only bounded AEAD overhead beyond this value.
MIGRATION_ROLLBACK_MAX_BYTES=536870912

# Required for capture and verify. Keep both values empty in committed examples.
# Inject them through the deployment secret mechanism; never commit real values.
MIGRATION_ROLLBACK_KEY_ID=
MIGRATION_ROLLBACK_KEY_B64=

# MIGRATION_ROLLBACK_KEY_B64 must be canonical base64 for exactly 32 random bytes.
# There is no generated key, default key, plaintext fallback, online rotation or
# KMS/HSM integration in this slice. Existing artifacts require the exact key ID
# and key material used at capture time.
