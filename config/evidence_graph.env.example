# Generation-scoped provenance evidence graph.
#
# This store is currently populated only through the validated programmatic
# EvidenceGraphStore boundary. The read-only CLI does not write graph state.
EVIDENCE_GRAPH_DB_PATH=data/evidence_graph.sqlite3

# The graph contains privacy-finalized section/annotation text. Protect this
# database with the same filesystem, backup, retention and access policy used
# for vector and sparse indexed evidence.

# Automatic ingestion integration is intentionally disabled until graph writes
# are coordinated as a derived fifth store through lifecycle reconciliation or
# an outbox. Do not assume graph availability for every authoritative document.
