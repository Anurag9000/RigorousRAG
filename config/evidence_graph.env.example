# Generation-scoped provenance evidence graph.
#
# This store is populated through validated graph construction and derived
# reconciliation boundaries. Authority-aware reads refuse stale current graph
# pointers before graph-derived evidence can be published.
EVIDENCE_GRAPH_DB_PATH=data/evidence_graph.sqlite3

# Durable exact-confirmation graph reconciliation jobs.
EVIDENCE_GRAPH_JOB_DB_PATH=data/evidence_graph_jobs.sqlite3

# Durable graph-payload compaction intents and receipts. Compaction may delete
# only verified non-current graph generations selected by an exact retention
# plan; it never deletes authoritative vector/sparse/generation state or the
# smaller graph-job audit rows.
EVIDENCE_GRAPH_COMPACTION_DB_PATH=data/evidence_graph_compaction.sqlite3

# The graph contains privacy-finalized section/annotation text. Protect graph,
# job and compaction databases with the same filesystem, backup, retention and
# access controls used for vector and sparse indexed evidence.

# Automatic ingestion integration and multi-process scheduling remain disabled
# until durable single-leader coordination and exact crash/fault injection are
# verified. Do not assume graph availability for every authoritative document.
