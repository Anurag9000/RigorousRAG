{
  "schema": "rigorousrag-authoritative-classical-training/v1",
  "kind": "listwise_fusion",
  "source_revision": "auto",
  "train_data": "../data/training/classical/listwise_fusion_train.jsonl",
  "validation_data": "../data/training/classical/listwise_fusion_validation.jsonl",
  "output_dir": "../artifacts/training/classical/listwise_fusion",
  "profile_ids": ["dense", "sparse", "late_interaction"],
  "calibration_contract": "../artifacts/calibration/retrieval/calibration_contract.json",
  "calibration_artifacts": {
    "dense": "../artifacts/calibration/retrieval/dense.json",
