  "training": {
    "epochs": 100,
    "batch_size": 8,
    "learning_rate": 0.05,
    "l2": 0.0001,
    "gradient_clip_norm": 5.0,
    "target_temperature": 1.0,
    "prediction_temperature": 1.0,
    "patience": 10,
    "min_delta": 0.00001,
    "seed": 29
  }
