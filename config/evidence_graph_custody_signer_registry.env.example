# Public Ed25519 custody signer registry. This database stores only owner/key/issuer
# scope, public-key fingerprints, active/retired state, and actor-binding audit data.
# It never stores private keys, public-key files, or key paths.
EVIDENCE_GRAPH_RESTORE_CUSTODY_SIGNER_DB_PATH=data/evidence_graph_set_signed_retirement_custody_signers.sqlite3

# Signer administration reuses exactly one process-owned reviewer actor source from
# the main environment configuration:
# EVIDENCE_GRAPH_REVIEW_ACTOR_ID=
# EVIDENCE_GRAPH_REVIEW_ACTOR_ID_PATH=
# EVIDENCE_GRAPH_REVIEW_ACTOR_ASSERTION_PATH=
# EVIDENCE_GRAPH_REVIEW_ACTOR_HMAC_KEY_PATH=
# EVIDENCE_GRAPH_REVIEW_ACTOR_EXPECTED_ISSUER=
