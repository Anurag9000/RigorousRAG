# Compose publishes to loopback by default. Set 0.0.0.0 only behind deliberate auth,
# firewall, and reverse-proxy configuration.
RIGOROUSRAG_BIND_ADDRESS=127.0.0.1
RIGOROUSRAG_PORT=8000

# Model provider
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEFAULT_MODEL=gpt-4o
SUMMARY_MODEL=gpt-4o-mini
ALLOWED_MODELS=gpt-4o,gpt-4o-mini
# Optional model used only for retrieval query expansion.
RETRIEVAL_EXPANSION_MODEL=
MAX_RESPONSE_TOKENS=2000
MAX_TOOL_ARGUMENT_CHARS=50000
MAX_TOOL_RESULT_CHARS=30000
MAX_EVIDENCE_SOURCES=100
MAX_CONCURRENT_TOOL_WORKERS=32
# Running plus queued process-wide tool tasks; excess calls fail closed.
MAX_PENDING_TOOL_TASKS=64
# Timeout for the classic CLI OpenAI-compatible summarizer.
LEGACY_LLM_TIMEOUT_SECONDS=60

# HTTP research-query and direct scientific-route admission/runtime
QUERY_WORKERS=8
QUERY_MAX_PENDING=32
QUERY_TIMEOUT_SECONDS=120

# Optional public web search
SERPER_API_KEY=
SERPER_MAX_RESPONSE_BYTES=2000000
# Maximum provider result objects inspected and public-address validated per call.
WEB_SEARCH_MAX_RESULT_CANDIDATES=30

# Identity: use one mode only. API-key mode is required before publishing beyond loopback.
SINGLE_USER_OWNER_ID=default_user
# API_KEY_OWNERS_JSON={"replace-with-random-key":"alice"}

# Storage, retrieval, and retention
UPLOAD_DIR=uploads
CHROMA_PATH=rag_storage
SPARSE_INDEX_PATH=data/sparse_index.sqlite3
INDEX_GENERATION_DB_PATH=data/index_generations.sqlite3
# Rebuildable generation-scoped provenance graph and its operator-driven job journal.
# Graph reconciliation never mutates authoritative vector, sparse or generation state.
EVIDENCE_GRAPH_DB_PATH=data/evidence_graph.sqlite3
EVIDENCE_GRAPH_JOB_DB_PATH=data/evidence_graph_jobs.sqlite3
# Immutable cross-document graph-set versions and one logical-key current pointer.
# Graph sets contain explicit reviewed relations and no node text.
EVIDENCE_GRAPH_SET_DB_PATH=data/evidence_graph_sets.sqlite3
# Immutable text-free cross-document relation proposals and terminal reviewer decisions.
EVIDENCE_GRAPH_RELATION_DB_PATH=data/evidence_graph_relations.sqlite3
# Durable authorization receipts for governed reviewer decisions.
EVIDENCE_GRAPH_REVIEW_AUTH_DB_PATH=data/evidence_graph_review_authorizations.sqlite3
# Immutable scientific-claim proposals plus atomic terminal decisions/authorizations.
# Extractor output enters this store only through the closed, generation-bound claim adapter.
EVIDENCE_GRAPH_CLAIM_REVIEW_DB_PATH=data/evidence_graph_claim_reviews.sqlite3
# Configure exactly one scientific-claim review policy source. Claim decisions fail closed
# when neither or both are configured. Leave both empty until placeholders are replaced.
EVIDENCE_GRAPH_CLAIM_REVIEW_POLICY_PATH=
# Example path after replacing every placeholder ID:
# EVIDENCE_GRAPH_CLAIM_REVIEW_POLICY_PATH=config/evidence_graph_claim_review_policy.example.json
# EVIDENCE_GRAPH_CLAIM_REVIEW_POLICY_JSON={"schema_version":1,"reviewers":[...]}
# Immutable exact-version registry for model/rule scientific-claim extractors.
# It stores implementation/configuration/schema digests and capabilities, never credentials.
EVIDENCE_GRAPH_CLAIM_EXTRACTOR_REGISTRY_DB_PATH=data/evidence_graph_claim_extractors.sqlite3
# Configure exactly one extractor-administrator policy source. Registration/retirement
# fail closed when neither or both are configured. Leave both empty by default.
EVIDENCE_GRAPH_CLAIM_EXTRACTOR_POLICY_PATH=
# Example path after replacing every placeholder ID:
# EVIDENCE_GRAPH_CLAIM_EXTRACTOR_POLICY_PATH=config/evidence_graph_claim_extractor_policy.example.json
# EVIDENCE_GRAPH_CLAIM_EXTRACTOR_POLICY_JSON={"schema_version":1,"administrators":[...]}
# Configure exactly one reviewer-policy source. Decisions fail closed when neither or
# both are configured. Leave both empty until a reviewed policy is deliberately installed.
EVIDENCE_GRAPH_REVIEW_POLICY_PATH=
# Example path after replacing every placeholder ID:
# EVIDENCE_GRAPH_REVIEW_POLICY_PATH=config/evidence_graph_relation_review_policy.example.json
# EVIDENCE_GRAPH_REVIEW_POLICY_JSON={"schema_version":1,"reviewers":[...]}
# Configure exactly one reviewer actor source for decision, legal-hold, and retention-
# deletion authorization commands. Leave all empty until a process identity or signed
# assertion is deliberately provisioned.
EVIDENCE_GRAPH_REVIEW_ACTOR_ID=
EVIDENCE_GRAPH_REVIEW_ACTOR_ID_PATH=
# Stronger short-lived HMAC assertion mode; all three values are required together.
EVIDENCE_GRAPH_REVIEW_ACTOR_ASSERTION_PATH=
EVIDENCE_GRAPH_REVIEW_ACTOR_HMAC_KEY_PATH=
EVIDENCE_GRAPH_REVIEW_ACTOR_EXPECTED_ISSUER=
# Durable one-decision reservation and replay audit for signed actor assertions.
EVIDENCE_GRAPH_REVIEW_ACTOR_USE_DB_PATH=data/evidence_graph_review_actor_uses.sqlite3
# Durable phase journal for authorization-only reviewed graph-set publication.
EVIDENCE_GRAPH_SET_PUBLICATION_DB_PATH=data/evidence_graph_set_publications.sqlite3
# Isolated durable journal for signed actor-use publication. This path must not equal
# or hard-link to EVIDENCE_GRAPH_SET_PUBLICATION_DB_PATH.
EVIDENCE_GRAPH_SET_SIGNED_PUBLICATION_DB_PATH=data/evidence_graph_set_signed_publications.sqlite3
# Third isolated journal for crash-recoverable retirement of expired authorization-only
# duplicates. It must not equal or hard-link to either publication journal path.
EVIDENCE_GRAPH_SET_SIGNED_RETIREMENT_DB_PATH=data/evidence_graph_set_signed_retirements.sqlite3
# Fourth isolated journal for terminal snapshot restore intents. It must not equal or
# hard-link to the target retirement database or either publication journal.
EVIDENCE_GRAPH_SET_SIGNED_RETIREMENT_RESTORE_DB_PATH=data/evidence_graph_set_signed_retirement_restores.sqlite3
# Integrity-backed legal holds over restore intents. It must not alias any restore,
# retirement, authorization-only publication, or signed publication database.
EVIDENCE_GRAPH_SET_SIGNED_RETIREMENT_HOLD_DB_PATH=data/evidence_graph_set_signed_retirement_holds.sqlite3
# Integrity-backed, expiring authorization records for retention deletion.
# This journal never deletes restore history and must remain isolated from all restore,
# hold, custody, retirement, deletion, and publication databases.
EVIDENCE_GRAPH_SET_SIGNED_RETIREMENT_DELETION_AUTH_DB_PATH=data/evidence_graph_set_signed_retirement_deletion_authorizations.sqlite3
# Separate lease journal for crash-recoverable deletion of authorized terminal restore
# rows. It stores no source text and must not alias authorization, restore, hold, custody,
# signer, retirement, or publication databases.
EVIDENCE_GRAPH_SET_SIGNED_RETIREMENT_DELETION_DB_PATH=data/evidence_graph_set_signed_retirement_deletions.sqlite3
# Durable pre/post restore custody manifests. Keep this isolated from the target,
# hold, restore, retirement, deletion, and publication databases.
EVIDENCE_GRAPH_SET_SIGNED_RETIREMENT_CUSTODY_DB_PATH=data/evidence_graph_set_signed_retirement_custody.sqlite3
# Durable attempts for publishing pre-restore backup/receipt artifact pairs. This path
# must not equal or hard-link to custody artifacts, the target, or any journal above.
EVIDENCE_GRAPH_SET_SIGNED_RETIREMENT_CUSTODY_ARTIFACT_DB_PATH=data/evidence_graph_set_signed_retirement_custody_artifacts.sqlite3
# Governed Ed25519 custody signer public keys. Private signing keys are never configured,
# copied, or persisted by the registry; operators pass a protected key only to one sign call.
EVIDENCE_GRAPH_RESTORE_CUSTODY_SIGNER_KEY_DB_PATH=data/evidence_graph_restore_custody_signer_keys.sqlite3
# Text-free resumable GraphRAG benchmark runs and governed historical baselines.
EVIDENCE_GRAPH_RAG_RUN_DB_PATH=data/evidence_graph_rag_runs.sqlite3
EVIDENCE_GRAPH_RAG_BASELINE_DB_PATH=data/evidence_graph_rag_baselines.sqlite3
# Durable fourth-store lifecycle intent and private source-cleanup journals.
LIFECYCLE_OUTBOX_DB_PATH=data/lifecycle_outbox.sqlite3
LIFECYCLE_CLEANUP_DB_PATH=data/lifecycle_cleanup.sqlite3
# Maximum lifecycle operations replayed per bounded reconciliation pass.
LIFECYCLE_RECONCILE_LIMIT=100
# Worker lease for one lifecycle reconciliation claim.
LIFECYCLE_LEASE_SECONDS=60
# Optional privacy-safe adaptive-route diagnostics. Leave empty to disable persistence.
ADAPTIVE_TRACE_DB_PATH=
JOB_DB_PATH=data/jobs.sqlite3
DOCUMENT_DB_PATH=data/documents.sqlite3
# Directory containing manifest-committed classic crawl/index/PageRank state.
CLASSIC_STORAGE_DIR=data
# EMBEDDING_PROFILE selects a declarative built-in/operator profile. When empty, the
# historical EMBEDDING_MODEL setting is resolved through the compatibility registry.
EMBEDDING_PROFILE=
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Optional bounded JSON object of complete operator embedding profiles.
EMBEDDING_PROFILES_JSON=
# Isolated manifest-last vector/sparse artifacts for validated profile migrations.
# These artifacts are not live generations and are never cut over automatically.
MIGRATION_SHADOW_ROOT=data/migration_shadows
# Append-only non-mutating promotion reports for validated migration shadows.
# Eligible reports do not perform or authorize live generation cutover automatically.
MIGRATION_PROMOTION_ROOT=data/migration_promotions
# Append-only hashes/counts-only cutover preflights. These records do not contain
# rollback text and expose no approval, execution, pointer-swap or rollback action.
MIGRATION_CUTOVER_PREFLIGHT_ROOT=data/migration_cutover_preflights
MAX_CHUNKS_PER_DOCUMENT=10000
DOCUMENT_LIST_SCAN_BATCH=500
MAX_DOCUMENT_LIST_SCAN_CHUNKS=100000
MAX_VECTOR_METADATA_ITEMS=200
MAX_SECTIONS_PER_DOCUMENT=10000
MAX_RAG_QUERY_CHARS=20000
# Maximum bytes for each manifest-committed classic crawl/index/PageRank member.
CLASSIC_MAX_SNAPSHOT_FILE_BYTES=250000000
# Internal handbook loading and chunk-generation ceilings.
HANDBOOK_MAX_BYTES=1000000
HANDBOOK_MAX_CHUNKS=1000
# Retained source files enable figure/visual tools when they pass visual budgets.
RETAIN_SOURCE_FILES=true
# Delete only old regular files unreferenced by active jobs or retained documents.
ORPHAN_CLEANUP_ON_STARTUP=true
ORPHAN_GRACE_SECONDS=3600

# Durable ingestion and bounded admission
INGEST_WORKERS=2
# Running plus queued executor futures. Additional durable jobs remain queued and retry admission.
INGEST_MAX_PENDING=64
INGEST_ADMISSION_RETRY_SECONDS=1
INGEST_MAX_ATTEMPTS=3
INGEST_RETRY_BASE_SECONDS=2
INGEST_RETRY_MAX_SECONDS=30
JOB_TTL_SECONDS=86400

# Parser complexity limits
MAX_PDF_PAGES=2000
MAX_PDF_RENDER_PIXELS=40000000
MAX_EXTRACTED_CHARS=5000000
MAX_DOCX_MEMBERS=10000
MAX_DOCX_UNCOMPRESSED_BYTES=200000000
MAX_DOCX_COMPRESSION_RATIO=1000

# Retained-PDF visual-analysis limits. The renderer uses a fixed maximum 565-point caption clip.
VISUAL_MAX_PDF_PAGES=500
VISUAL_MAX_RENDER_PIXELS=2000000
VISUAL_MAX_ENCODED_BYTES=10000000

# Optional bounded OCR for scanned/mixed PDFs
ENABLE_OCR=false
OCR_MAX_PAGES=50
OCR_DPI=200
OCR_TIMEOUT_SECONDS=30
OCR_MIN_TEXT_CHARS=40

# Network and API budgets
MAX_UPLOAD_BYTES=50000000
# Total JSON/multipart body ceiling, including multipart framing overhead.
MAX_REQUEST_BODY_BYTES=51048576
MAX_REMOTE_DOWNLOAD_BYTES=5000000
# Maximum outbound JSON/text/bytes body accepted by the shared downloader.
MAX_REMOTE_REQUEST_BODY_BYTES=1000000
REMOTE_REQUEST_TIMEOUT_SECONDS=15
MAX_REMOTE_REDIRECTS=4
REQUESTS_PER_MINUTE=60

# Bounded privacy-conscious telemetry
USAGE_LOG_FILE=data/usage_metrics.jsonl
USAGE_LOG_MAX_BYTES=10485760
USAGE_LOG_BACKUPS=3

# Container readiness probe
HEALTHCHECK_URL=http://127.0.0.1:8000/health
HEALTHCHECK_TIMEOUT_SECONDS=3
