     if not (path.exists() or path.is_symlink()):
         return None
     info = os.lstat(path)
     if _is_link_or_reparse(info) or not stat.S_ISREG(info.st_mode):
         raise ValueError("The lock output must be absent or a safe regular file.")
-    return _identity(info)
